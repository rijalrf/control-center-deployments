# ============================================================
# Control Center Deployments — Environment Configuration
# ============================================================
# Salin file ini menjadi .env dan isi semua nilai yang diperlukan:
#   cp .env.example .env
# ============================================================

# ============================================================
# APP
# ============================================================
NODE_ENV=development                          # development | production
BACKEND_PORT=5000                             # Port backend berjalan
FRONTEND_URL=http://localhost:3000            # URL frontend (tanpa trailing slash)

# ============================================================
# JWT (JSON Web Token)
# ============================================================
# Generate secret dengan perintah:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d                             # Format: 7d | 24h | 60m

# ============================================================
# DATABASE (MySQL)
# ============================================================
DB_HOST=ccd-mysql                             # Nama service Docker / host database
DB_PORT=3306
DB_NAME=ccd_db
DB_USER=ccd_user
DB_PASSWORD=your_db_user_password
DB_ROOT_PASSWORD=your_db_root_password        # Hanya untuk inisialisasi Docker MySQL

# ============================================================
# GITHUB PERSONAL ACCESS TOKEN (PAT)
# ============================================================
# Cara membuat PAT:
#   1. Buka: https://github.com/settings/tokens
#   2. Klik "Generate new token (classic)"
#   3. Centang scope: repo, workflow, read:org
# Digunakan untuk: sync repositories, trigger workflow dispatch
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Opsional: nama organisasi GitHub
# Jika diisi, repo yang di-sync adalah repo milik org
# Jika kosong, repo yang di-sync adalah repo milik user yang login
GITHUB_ORG=

# ============================================================
# CENTRAL DEPLOYER (GitHub Actions Workflow Dispatch)
# ============================================================
# Repo yang menyimpan file .github/workflows/central-deploy.yml
# Token (GITHUB_TOKEN di atas) harus punya akses write ke repo ini
GITHUB_CENTRAL_OWNER=your_github_username_or_org
GITHUB_CENTRAL_REPO=control-center-deployments
GITHUB_CENTRAL_WORKFLOW=central-deploy.yml
GITHUB_CENTRAL_REF=main                        # Branch yang digunakan untuk workflow (default: main)

# ============================================================
# FRONTEND (Vite) — wajib prefix VITE_
# ============================================================
# URL backend yang diakses dari browser (bukan dari dalam Docker)
VITE_API_URL=http://localhost:5000

# ============================================================
# DOCKER CLEANUP (PRUNE) ON TARGET SERVER
# ============================================================
# Strategy for cleaning up unused/old Docker images on target server after successful deploy.
# Options: dangling (clean dangling images only) | all (clean all unused images) | empty (do not clean)
# Jika diset ke  dangling : Otomatis menjalankan  docker image prune -f  di server target.
# Jika diset ke  all : Otomatis menjalankan  docker image prune -a -f  di server target.
# Jika dikosongkan: Tidak ada pembersihan otomatis yang berjalan
DOCKER_PRUNE_STRATEGY=
